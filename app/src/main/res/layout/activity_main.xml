<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#080808" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♛" android:textColor="#FF334F" android:fontFamily="sans-serif" android:textSize="38sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="455" android:textColor="#FF334F" android:fontFamily="sans-serif" android:textSize="34sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="LEITOR DE TELA + VISÃO" android:textColor="#FFFFFF" android:fontFamily="sans-serif" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Selecione uma região ou leia a tela inteira. O Aurora detecta automaticamente o idioma do texto e traduz para português, sem precisar escolher manualmente. O processamento é feito no aparelho." android:textColor="#D0D0D0" android:fontFamily="sans-serif" android:textSize="15sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="IDIOMAS EM DESTAQUE" android:textColor="#FF334F" android:textStyle="bold" android:fontFamily="sans-serif" android:textSize="13sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Escolha o idioma de origem. O destino será sempre português. Estes quatro idiomas ficam em primeiro plano:" android:textColor="#BDBDBD" android:textSize="13sp"/>
<RadioGroup android:id="@+id/rgLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="#191919" android:padding="16dp">
<RadioButton android:id="@+id/rbAuto" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:buttonTint="#FF334F" android:text="Detectar automaticamente → Português" android:textColor="#FFFFFF" android:padding="8dp"/>
<RadioButton android:id="@+id/rbJa" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#FF334F" android:text="★ Japonês → Português" android:textColor="#FFFFFF" android:padding="8dp"/>
<RadioButton android:id="@+id/rbZh" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#FF334F" android:text="★ Chinês / Hanzi (汉字) → Português" android:textColor="#FFFFFF" android:padding="8dp"/>
<RadioButton android:id="@+id/rbKo" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#FF334F" android:text="★ Coreano → Português" android:textColor="#FFFFFF" android:padding="8dp"/>
<RadioButton android:id="@+id/rbEn" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#FF334F" android:text="★ Inglês → Português" android:textColor="#FFFFFF" android:padding="8dp"/>
</RadioGroup>
<Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:backgroundTint="#FF334F" android:text="ATIVAR LEITOR" android:textColor="#080808" android:textStyle="bold" android:fontFamily="sans-serif" android:textSize="16sp"/>
<Button android:id="@+id/btnStop" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:backgroundTint="#351018" android:text="PARAR LEITOR E REMOVER BOTÃO" android:textColor="#FF334F" android:textStyle="bold" android:fontFamily="sans-serif" android:textSize="14sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#191919" android:padding="16dp" android:text="CONTROLES FLUTUANTES\nToque no botão vermelho para abrir a seleção de texto. Toque e segure para abrir as ferramentas: TELA INTEIRA, SELECIONAR TEXTO, VISÃO e ENCERRAR.\n\nArraste o botão para qualquer lado da tela; a posição fica salva e é ajustada quando você gira o celular. Durante a seleção e a captura, o botão some temporariamente para não cobrir o conteúdo.\n\nNa seleção, arraste para desenhar a área. Depois mova a moldura ou arraste qualquer um dos quatro cantos para ajustar o tamanho diretamente na tela. Toque em LER para ouvir a tradução, sem abrir uma janela de texto, ou em CANCELAR para voltar.\n\nA análise visual reconhece categorias gerais de objetos e texto, mas não descreve toda a cena como uma pessoa." android:textColor="#E6E6E6" android:fontFamily="sans-serif" android:textSize="14sp"/>
</LinearLayout>
</ScrollView>