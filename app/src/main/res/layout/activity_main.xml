<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#071321" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♛" android:textColor="#FFCD5A" android:textSize="38sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="455" android:textColor="#24C7E8" android:textSize="34sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="LEITOR DE TELA" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Instale os pacotes de reconhecimento e tradução que quiser. Depois, a leitura e a tradução são feitas no próprio celular." android:textColor="#AFC4D5" android:textSize="15sp"/>
        <Button android:id="@+id/btnLanguages" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:backgroundTint="#173B55" android:text="GERENCIAR IDIOMAS OFFLINE" android:textColor="#FFFFFF" android:textStyle="bold"/>
        <TextView android:id="@+id/tvSelectedLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#10263A" android:padding="16dp" android:text="Idioma selecionado: Japonês" android:textColor="#FFFFFF" android:textSize="15sp"/>
        <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:backgroundTint="#13AFCF" android:text="ATIVAR LEITOR" android:textColor="#061522" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#10263A" android:padding="16dp" android:text="Depois de ativar, use o botão flutuante: ① TELA lê o texto da tela inteira; ② ÁREA permite selecionar somente uma parte. Arraste o botão para mudar de lugar e toque em × para encerrar. Os pacotes precisam ser baixados uma vez com internet. Depois, o reconhecimento e a tradução funcionam localmente, inclusive sem internet." android:textColor="#C6D7E4" android:textSize="14sp"/>
    </LinearLayout>
</ScrollView>