<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#080808" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♛" android:textColor="#FFCD5A" android:textSize="38sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="455" android:textColor="#FFCD5A" android:textSize="34sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="LEITOR DE TELA + VISÃO" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Leia textos da tela ou selecione uma região para reconhecer elementos visuais. A análise visual básica funciona localmente no aparelho." android:textColor="#D0D0D0" android:textSize="15sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="IDIOMA DO TEXTO" android:textColor="#FFCD5A" android:textStyle="bold" android:textSize="13sp"/>
<RadioGroup android:id="@+id/rgLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="#191919" android:padding="16dp">
<RadioButton android:id="@+id/rbJa" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:buttonTint="#FFCD5A" android:text="Japonês → Português" android:textColor="#FFFFFF" android:padding="8dp"/>
<RadioButton android:id="@+id/rbKo" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#FFCD5A" android:text="Coreano → Português" android:textColor="#FFFFFF" android:padding="8dp"/>
<RadioButton android:id="@+id/rbEn" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#FFCD5A" android:text="Inglês → Português" android:textColor="#FFFFFF" android:padding="8dp"/>
</RadioGroup>
<Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:backgroundTint="#FFCD5A" android:text="ATIVAR LEITOR" android:textColor="#080808" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#191919" android:padding="16dp" android:text="BOTÃO FLUTUANTE\n① TELA — lê o texto visível na tela inteira.\n② TEXTO — selecione com o dedo uma região para reconhecer e traduzir o texto.\n③ VISÃO — selecione uma região para identificar categorias de objetos e elementos visuais, com processamento local.\n× — encerra a leitura. Arraste o botão para reposicionar.\n\nA análise visual usa um modelo leve de classificação: reconhece categorias gerais, mas ainda não cria uma descrição completa da cena nem identifica pessoas." android:textColor="#E6E6E6" android:textSize="14sp"/>
</LinearLayout>
</ScrollView>