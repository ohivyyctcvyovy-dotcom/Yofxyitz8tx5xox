<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#173B50"
                android:gravity="center"
                android:text="朗"
                android:textColor="#65E0CF"
                android:textSize="23sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEITOR DE TELA"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRADUÇÃO OFFLINE"
                    android:textColor="#65E0CF"
                    android:textSize="10sp"
                    android:letterSpacing="0.12" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Entenda qualquer tela.\nLeia tudo em português."
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:lineSpacingExtra="3dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Reconheça textos em outros idiomas, traduza e escute a leitura diretamente no seu celular."
            android:textColor="#A9BBCB"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#10263A"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IDIOMA DE DESTINO"
                android:textColor="#8FA8BC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🇧🇷  Português — sempre"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Todos os idiomas selecionados serão traduzidos para português."
                android:textColor="#A9BBCB"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSelectedLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#132D43"
            android:padding="16dp"
            android:text="🇯🇵  Japonês   →   🇧🇷 Português"
            android:textColor="#EAF4FA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#62DCC8"
            android:text="ATIVAR LEITOR"
            android:textColor="#071923"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLanguages"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#203D55"
            android:text="GERENCIAR IDIOMAS OFFLINE"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#10263A"
            android:padding="17dp"
            android:text="COMO USAR\n\n1. Instale os idiomas que deseja reconhecer.\n2. Escolha um idioma na biblioteca.\n3. Ative o leitor e autorize a captura de tela.\n4. Use o botão flutuante para ler a tela inteira ou selecionar uma área.\n\nDepois de baixar os pacotes, a leitura e a tradução funcionam sem internet."
            android:textColor="#B8C9D7"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="PRIVACIDADE EM PRIMEIRO LUGAR  •  PROCESSAMENTO NO APARELHO"
            android:textColor="#698399"
            android:textSize="10sp"
            android:letterSpacing="0.04" />
    </LinearLayout>
</ScrollView>